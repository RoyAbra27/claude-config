{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "version": 4,
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "foreground": "#c44d4d",
          "style": "plain",
          "template": "\uf0e7 ",
          "type": "root"
        },
        {
          "foreground": "#6b9ece",
          "style": "plain",
          "template": "{{ if .WSL }}WSL {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "#6aab6a",
          "properties": {
            "folder_separator_icon": " \ue0b1 ",
            "style": "agnoster_short",
            "max_depth": 3
          },
          "style": "plain",
          "template": "\ue5ff {{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#6b8fad",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          },
          "style": "plain",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ if .Staging.Changed }} <#b8a040>\uf046 {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} <#a87a8a>\uf044 {{ .Working.String }}</>{{ end }}{{ if gt .StashCount 0 }} <#b08a58>\ueb4b {{ .StashCount }}</>{{ end }}{{ if gt .Ahead 0 }} <#6a9a6a>\uf55c {{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }} <#a05555>\uf544 {{ .Behind }}</>{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "#6a9a6a",
          "properties": {
            "fetch_package_manager": true,
            "display_mode": "files"
          },
          "style": "plain",
          "template": "<#555>\ue0b1</> \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "foreground": "#7a8aaa",
          "properties": {
            "display_mode": "files",
            "fetch_virtual_env": true
          },
          "style": "plain",
          "template": "<#555>\ue0b1</> \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}({{ .Venv }}) {{ end }}{{ .Full }}{{ end }} ",
          "type": "python"
        }
      ]
    },
    {
      "alignment": "right",
      "type": "prompt",
      "overflow": "hide",
      "segments": [
        {
          "foreground": "#8a6a9a",
          "properties": {
            "style": "austin",
            "threshold": 500
          },
          "style": "plain",
          "template": "\ueba2 {{ .FormattedMs }} ",
          "type": "executiontime"
        },
        {
          "foreground": "#b89040",
          "properties": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": "{{ .CurrentDate | date .Format }}",
          "type": "time"
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "type": "prompt",
      "segments": [
        {
          "foreground": "#6aab6a",
          "foreground_templates": ["{{ if gt .Code 0 }}#a05555{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u276f ",
          "type": "status"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#6aab6a",
    "foreground_templates": ["{{ if gt .Code 0 }}#a05555{{ end }}"],
    "template": "\u276f "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#b89040",
    "template": "\u276f\u276f "
  },
  "console_title_template": "{{if .Root}}(Admin) {{end}}{{.Folder}}"
}
